# Copiez ce fichier en ".env" et remplissez les valeurs réelles.
# Ne jamais commiter le fichier ".env" (mot de passe en clair).

# --- Serveur ---
PORT=3000

# --- Base de données (LibSQL / Turso) ---
# Local : garder "file:./data/guests.db". Production Vercel : URL Turso cloud.
TURSO_DATABASE_URL=file:./data/guests.db
# Laisser vide en local. Obligatoire sur Turso cloud (turso db tokens create <nom>).
TURSO_AUTH_TOKEN=

# --- Contrôleur UniFi (auto-hébergé, non-UniFi OS) ---
# URL de base du contrôleur, avec le port 8443 (par défaut sur une install classique).
UNIFI_CONTROLLER_URL=https://192.168.1.10:8443

# Compte local dédié (recommandé : créez un admin local séparé plutôt que
# d'utiliser un compte cloud Ubiquiti — les comptes cloud avec 2FA ne
# fonctionnent pas avec ce type d'authentification).
UNIFI_USERNAME=portail-captif
UNIFI_PASSWORD=change-me

# Nom du site UniFi tel qu'il apparaît dans l'URL du contrôleur
# (souvent "default" si un seul site est configuré).
UNIFI_SITE=default

# Laisser vide pour un contrôleur auto-hébergé classique.
# Ne mettre "/proxy/network" que si le client migre un jour vers un
# boîtier UniFi OS (UDM Pro, Cloud Gateway...).
UNIFI_API_PREFIX=

# "true" tant que le contrôleur utilise son certificat auto-signé par défaut
# (cas quasi systématique en local). Mettre "false" si un vrai certificat est installé.
UNIFI_ALLOW_INSECURE_TLS=true

# Durée d'accès accordée à chaque autorisation, en minutes (480 = 8h).
UNIFI_AUTHORIZE_MINUTES=480
